# Copie este arquivo para .env e preencha a chave (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-SUA_CHAVE

# Modelos em ordem de preferência (fallback automático se um falhar, ex.: 429)
MODELOS=nvidia/nemotron-3.5-lightning:free,z-ai/glm-5.2:free,openrouter/free

# Caminho do banco SQLite (camada Gold)
CAMINHO_BANCO=cinerocket.db

# Máximo de chamadas ao LLM por pergunta (protege a cota de 50/dia)
MAX_REQUISICOES_POR_PERGUNTA=4
